.env
service-account-key.json

# Bulky scratch data not needed at runtime
tmp_synth/
synthetic_audio/
synthetic_training_features*.csv
clinical_review_queue.csv
publication_data_targets.csv
synthetic_grbas_manifest.csv

# Tests don't need to be in the deployed image
tests/

# Editor / VCS noise
.git/
.gitignore
.vscode/
.idea/
*.bak
